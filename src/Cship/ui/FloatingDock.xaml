<components:GlassWindow
    x:Class="Cship.Ui.FloatingDock"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:Cship.Ui.Components"
    Title="Cship">
    <!-- 窗口外观（None/透明/无任务栏）由 GlassWindow 基类装配；
         置顶策略基类不写死，FloatingDock 按 advanced.dockPriority 三档自声明（4.8，01b 补丁） -->
    <Grid>
        <components:SquarePlate x:Name="Plate"/>
        <!-- 首开加载点（清单二·任务13）：首载未就绪时两侧各 3 点竖排循环闪烁，
             就绪后"散开+淡出"消失再走正常消散开板。平时 Opacity=0 不参与命中 -->
        <StackPanel x:Name="LoadingLeft" Orientation="Vertical" HorizontalAlignment="Left"
                    VerticalAlignment="Center" Margin="16,0,0,0" Opacity="0"
                    IsHitTestVisible="False">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="LoadingLeftShift" X="0" Y="0"/>
            </StackPanel.RenderTransform>
            <Ellipse x:Name="LeftDot1" Width="6" Height="6" Fill="#B4888888" Margin="0,4,0,0" Opacity="0"/>
            <Ellipse x:Name="LeftDot2" Width="6" Height="6" Fill="#B4888888" Margin="0,4,0,0" Opacity="0"/>
            <Ellipse x:Name="LeftDot3" Width="6" Height="6" Fill="#B4888888" Margin="0,4,0,0" Opacity="0"/>
        </StackPanel>
        <StackPanel x:Name="LoadingRight" Orientation="Vertical" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Margin="0,0,16,0" Opacity="0"
                    IsHitTestVisible="False">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="LoadingRightShift" X="0" Y="0"/>
            </StackPanel.RenderTransform>
            <Ellipse x:Name="RightDot1" Width="6" Height="6" Fill="#B4888888" Margin="0,4,0,0" Opacity="0"/>
            <Ellipse x:Name="RightDot2" Width="6" Height="6" Fill="#B4888888" Margin="0,4,0,0" Opacity="0"/>
            <Ellipse x:Name="RightDot3" Width="6" Height="6" Fill="#B4888888" Margin="0,4,0,0" Opacity="0"/>
        </StackPanel>
    </Grid>
</components:GlassWindow>
