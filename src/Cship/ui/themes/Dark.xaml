<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 暗色主题（00 §9 调色板 + 步骤 05 SettingsPalette 既有色值，逐字迁移）。 -->
    <Color x:Key="Color.Bg">#F21F1F1F</Color>
    <Color x:Key="Color.Card">#14161622</Color>
    <Color x:Key="Color.TextPrimary">#FFF2F2F2</Color>
    <Color x:Key="Color.TextSecondary">#FFB8B8B8</Color>
    <Color x:Key="Color.Divider">#FF3A3A3A</Color>
    <Color x:Key="Color.Accent">#FFD4D4D4</Color>
    <Color x:Key="Color.OnAccent">#FF1B1B1B</Color>
    <Color x:Key="Color.HoverOverlay">#14FFFFFF</Color>
    <Color x:Key="Color.Track">#33FFFFFF</Color>
    <Color x:Key="Color.Danger">#FFFF6B6B</Color>
    <Color x:Key="Color.MenuBg">#E61F1F1F</Color>
    <Color x:Key="Color.MenuBorder">#2EFFFFFF</Color>
    <Color x:Key="Color.MenuHover">#14FFFFFF</Color>
    <Color x:Key="Color.PlateBorder">#33FFFFFF</Color>

    <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}"/>
    <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource Color.Card}"/>
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Brush.Divider" Color="{StaticResource Color.Divider}"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}"/>
    <SolidColorBrush x:Key="Brush.HoverOverlay" Color="{StaticResource Color.HoverOverlay}"/>
    <SolidColorBrush x:Key="Brush.Track" Color="{StaticResource Color.Track}"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}"/>
    <SolidColorBrush x:Key="Brush.MenuBg" Color="{StaticResource Color.MenuBg}"/>
    <SolidColorBrush x:Key="Brush.MenuBorder" Color="{StaticResource Color.MenuBorder}"/>
    <SolidColorBrush x:Key="Brush.MenuHover" Color="{StaticResource Color.MenuHover}"/>
    <SolidColorBrush x:Key="Brush.PlateBorder" Color="{StaticResource Color.PlateBorder}"/>
</ResourceDictionary>
