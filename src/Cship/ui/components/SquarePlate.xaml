<UserControl x:Class="Cship.Ui.Components.SquarePlate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 画布 = 板边长 + Chrome(72)：左上 BaseMargin(24) 供上层板向外错开，
         右下预留 2×悬停错位 + 消散展开量。层序：Back(最后) → Mid → Front(最前)。 -->
    <Canvas x:Name="Root" Background="Transparent">
        <Border x:Name="PlateBack" CornerRadius="12" Canvas.Left="36" Canvas.Top="36"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="BackScale"/>
            </Border.RenderTransform>
            <Grid>
                <Border x:Name="NoiseBack" CornerRadius="12" Opacity="0.04" IsHitTestVisible="False"/>
                <Border CornerRadius="12" BorderThickness="0,1,0,0" BorderBrush="#4DFFFFFF" IsHitTestVisible="False"/>
            </Grid>
        </Border>
        <Border x:Name="PlateMid" CornerRadius="12" Canvas.Left="30" Canvas.Top="30">
            <Grid>
                <Border x:Name="NoiseMid" CornerRadius="12" Opacity="0.04" IsHitTestVisible="False"/>
                <Border CornerRadius="12" BorderThickness="0,1,0,0" BorderBrush="#66FFFFFF" IsHitTestVisible="False"/>
            </Grid>
        </Border>
        <Border x:Name="PlateFront" CornerRadius="12" Canvas.Left="24" Canvas.Top="24"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="FrontScale"/>
            </Border.RenderTransform>
            <Grid>
                <Border x:Name="NoiseFront" CornerRadius="12" Opacity="0.04" IsHitTestVisible="False"/>
                <Border CornerRadius="12" BorderThickness="0,1,0,0" BorderBrush="#80FFFFFF" IsHitTestVisible="False"/>
            </Grid>
        </Border>
    </Canvas>
</UserControl>
