<components:GlassWindow x:Class="Cship.Ui.BoardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:Cship.Ui.Components"
    Title="Cship 收纳板" MinWidth="160" MinHeight="107">
    <!-- 收纳板（步骤 1）：三层结构 z 自上而下 = 图标网格 / 材质背景 / 自定义背景图；
         定位、缩放热区、右键菜单、拖删换位在 code-behind 装配。
         2026-08-28 用户反馈：滚动条自绘现代化样式（细轨/圆角/半透明）。
         批次十二（原文任务5）：标题栏带整体移除，顶部 34px 仅作按钮/分类项容纳区与拖动移动热区；
         首行图标顶提到原标题栏底部位置（34px）。
         2026-10-05 需求①：滚动条改"Overlay 浮层"（见 Scroller 的内联模板）+ 图标区内边距 10/12 → 1px；
         MinWidth/MinHeight 480×320 → 160×107（原值 1/3，需求③）。 -->
    <components:GlassWindow.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <!-- 顶部让位右上角按钮行（齿轮/关闭，高 5+26=31）：滚动条从按钮行下方开始
                 （Overlay 模板里以局部 Margin 再声明一次，这里是默认模板路径的兜底） -->
            <Setter Property="Margin" Value="0,33,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <!-- 拇指条（2026-10-05 需求①）：4px 极细、默认更淡——
                                                     滚动条现在浮在图标之上，太实会盖住末列图标 -->
                                                <Border x:Name="ThumbBd" Background="#26888888"
                                                        CornerRadius="2" Width="4"
                                                        HorizontalAlignment="Center" Margin="0,2,0,2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBd" Property="Background" Value="#4A707070"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBd" Property="Background" Value="#66707070"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </components:GlassWindow.Resources>
    <Grid x:Name="Root" UseLayoutRounding="True">
        <!-- L3 自定义背景图层（personal.boardBg；无则 Collapsed）——**压在整摞最底**（2026-10-06 用户要求：
             自定义背景图片要在主题纯色板、收纳板材质之下），即"图片在底、材质/纯色板盖在它上面"。
             与决策 240（当时要求图片压在材质之上）相反：材质是半透明的（personal.boardOpacity），
             背景图要透出来靠的是板底自身的 α，而不是靠图片盖在上面。
             2026-10-04 错误修复⑤：改直接用圆角 Border 的 ImageBrush 作底——图像在**绘制层面**就被
             圆角几何裁切，不再依赖"Root.SizeChanged 时按 RenderSize 设 Clip"的时序（旧实现里背景图
             变为可见/尺寸变化而没补上裁剪时，方角与左/下边缘会溢出板底几像素） -->
        <Border x:Name="CustomBgHost" Visibility="Collapsed" CornerRadius="12" UseLayoutRounding="True"
                IsHitTestVisible="False"/>

        <!-- L3 之上的 10% 主题色遮罩（步骤 06 §5：保证背景图上的文字可读性）。
             位置仍在图片正上方（贴住它一起被材质盖），不随材质上移——它修饰的对象是图片本身 -->
        <Border x:Name="BgShade" Visibility="Collapsed" CornerRadius="12" UseLayoutRounding="True"
                IsHitTestVisible="False"/>

        <!-- L2 材质背景层（步骤 06：MaterialEngine——主题纯色板/材质配方 + 装饰 + 发丝描边） -->
        <components:MaterialBackground x:Name="Material"/>

        <!-- 锚边过渡阴影（2026-08-29）：弹出方向锚边贴屏幕边缘一侧由重到轻的渐变阴影，
             位置/朝向 Reposition 装配；center 模式隐藏 -->
        <Border x:Name="AnchorShadow" Height="44" VerticalAlignment="Bottom"
                IsHitTestVisible="False"/>

        <!-- L1 图标网格层（顶部 28px = 原标题栏底部位置，容纳分类项/设置/关闭按钮；
             22 + 首行图标自带的 6px 顶距 = 首行图标顶 28px）
             2026-10-05 需求①②：左右下内边距 10/10/12 → 1px——原来那一圈留白在观感上就是"厚边框"，
             还把首/末列与末行图标挤离板缘；改成 1px 后图标一直铺到板缘，只有真正越界时才被裁。
             2026-10-06 需求①：**左边距单独回到 6px**（最左列图标离板左缘多留几个像素，见
             BoardWindow.BoardPadLeft）；右侧仍是 1px，浮层滚动条不占宽度。
             内联模板把滚动条改成 **Overlay 浮层**（与内容同格、右对齐）：默认模板会为滚动条单独留
             一列 8px，叠上原 10px 留白，右侧就出现一条 ~18px 的实心带——既压住末列图标又白吃宽度。
             浮层后滚动条一像素宽度都不占，仅拇指条浮在内容之上。 -->
        <ScrollViewer x:Name="Scroller" Margin="6,28,1,1"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent" Focusable="False" PanningMode="VerticalOnly">
            <ScrollViewer.Template>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar" Orientation="Vertical"
                                   HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                   Margin="0,33,2,2"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                   Cursor="Arrow"/>
                    </Grid>
                </ControlTemplate>
            </ScrollViewer.Template>
            <ItemsControl x:Name="GridHost" Background="Transparent" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <components:IconGridPanel x:Name="IconPanel"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <components:IconItem/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 空态提示（7.4） -->
        <TextBlock x:Name="EmptyHint" Text="" FontSize="13"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed" IsHitTestVisible="False"/>

        <!-- 分类页顶栏（步骤 04 · 2026-09-25 改版）：收纳板顶部横向分类按钮行，
             位于标题栏带内左起（右侧 98px 留给垃圾桶/齿轮/关闭钮保护区）；
             溢出折叠/右键菜单/拖入热区/主题在 CategoryTabBar 与 code-behind -->
        <components:CategoryTabBar x:Name="CatTabBar" Height="24" VerticalAlignment="Top"
                                   HorizontalAlignment="Stretch" Margin="12,5,110,0" Panel.ZIndex="60"/>

        <!-- 右上角常驻控件（z 最高）：垃圾桶、设置齿轮、关闭红点从左到右水平排列（清单二·任务6），
             齿轮/关闭钮 26px、垃圾桶 22px 等高对齐；批次十二（原文任务9）：下方阴影取消 -->
        <StackPanel x:Name="Chrome" Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Margin="0,5,8,0" Panel.ZIndex="100">
            <!-- 垃圾桶（任务6：从右下角移入顶栏、缩小）：盖+身两块 Path，盖挂 Translate+Rotate
                 （悬停向上微开 / 图标拖到其上向上+侧向微开，铰链感）；单击打开系统回收站 -->
            <Grid x:Name="TrashBtn" Width="22" Height="22" Cursor="Hand" Background="Transparent"
                  Focusable="False" VerticalAlignment="Center" Margin="0,0,2,0">
                <!-- 灰色圆角方形底板（修订A·4.4）：悬停过渡浮现，图标拖入时转为深灰 -->
                <Border x:Name="TrashPlate" CornerRadius="6" Background="#1A9E9E9E" Opacity="0"
                        Visibility="Collapsed" IsHitTestVisible="False"/>
                <Ellipse x:Name="TrashHalo" Fill="#26FF6B6B" Visibility="Collapsed"/>
                <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path x:Name="TrashBody" Data="M6,19c0,1.1,0.9,2,2,2h8c1.1,0,2-0.1,2-2V7H6V19z"
                              Fill="#5F5F5F" Opacity="0.8"/>
                        <Path x:Name="TrashLid" Data="M19,4h-3.5l-1-1h-5l-1,1H5v2h14V4z"
                              Fill="#5F5F5F" Opacity="0.8" RenderTransformOrigin="0,1">
                            <Path.RenderTransform>
                                <TransformGroup>
                                    <TranslateTransform x:Name="TrashLidShift" X="0" Y="0"/>
                                    <RotateTransform x:Name="TrashLidTilt" Angle="0"/>
                                </TransformGroup>
                            </Path.RenderTransform>
                        </Path>
                    </Canvas>
                </Viewbox>
            </Grid>
            <!-- 设置齿轮（hover 慢转+微亮） -->
            <Grid x:Name="GearBtn" Width="26" Height="26" Cursor="Hand" Background="Transparent" Focusable="False">
                <Path x:Name="GearIcon" Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"
                      Stretch="Uniform" Width="16" Height="16" Opacity="0.85" VerticalAlignment="Center"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="GearRotate" Angle="0"/>
                    </Path.RenderTransform>
                </Path>
            </Grid>
            <!-- 关闭红点（批次十二重做，原文任务9）：hover 红点中心过渡浮现黑叉号 + 红色亮度提高；
                 命中区=整个 26px 按钮容器 -->
            <Grid x:Name="CloseBtn" Width="26" Height="26" Cursor="Hand" Background="Transparent"
                  Focusable="False" Margin="2,0,0,0">
                <Ellipse x:Name="CloseDot" Width="13" Height="13" Fill="#FF5F57"/>
                <Path x:Name="CloseX" Data="M4.25,4.25 L8.75,8.75 M8.75,4.25 L4.25,8.75"
                      Stroke="#141414" StrokeThickness="1.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Stretch="None" Width="13" Height="13" Opacity="0" IsHitTestVisible="False"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>

        <!-- 悬停文件名提示层（2026-10-04 错误修复④）：单例浮层画在图标/按钮之上，
             由 code-behind 定位到目标图标正上方（不遮挡目标图标）；完整名字不裁剪（超长在板内换行）、
             底色完全不透明、显示/隐藏瞬时无动画。Canvas 与其子元素都不参与命中测试，不影响交互 -->
        <Canvas x:Name="TipLayer" IsHitTestVisible="False" Panel.ZIndex="200">
            <Border x:Name="HoverTip" Visibility="Collapsed" CornerRadius="6" Padding="7,3" Background="#FF303030">
                <TextBlock x:Name="HoverTipText" FontSize="12" Foreground="#FFF2F2F2" TextWrapping="Wrap"/>
            </Border>
        </Canvas>

        <!-- 拖入文件夹提示层（2026-10-05 清单06任务3）：拖动的图标落在某个**文件夹**图标的中心圈
             （半径=图标宽度 1/3）内时，在该图标四周浮出一圈粗描边（不与图标贴合，留 FolderRingGapPx
             间距；颜色随主题反相=黑主题白/白主题黑，出现与消失都是渐变过渡，时长 Micro）。
             几何/配色/淡入淡出全部在 code-behind 装配；不参与命中测试 -->
        <Canvas x:Name="FolderRingLayer" IsHitTestVisible="False" Panel.ZIndex="150">
            <Border x:Name="FolderDropRing" Visibility="Collapsed" Opacity="0"
                    Background="Transparent" BorderThickness="3" CornerRadius="18"/>
        </Canvas>

    </Grid>
</components:GlassWindow>
