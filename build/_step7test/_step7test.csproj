       直接调用本步新增能力做端到端验证。零第三方依赖。运行见 build\run_step7test.ps1 -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
