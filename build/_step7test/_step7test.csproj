    <Compile Include="..\..\src\Cship\core\SystemBridge.cs" />
    <Compile Include="..\..\src\Cship\core\Autostart.cs" />
    <Compile Include="..\..\src\Cship\core\Paths.cs" />
  </ItemGroup>

</Project>
